# Discord bot token - Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# PUBG API key - https://developer.pubg.com/ > sign in > create an app
PUBG_API_KEY=

# Optional. Platform shard PUBG API calls are made against. Defaults to
# "steam" if not set - only change this if your clan plays on a different
# platform (e.g. "kakao", "psn", "xbox").
PUBG_SHARD=steam

# Slash commands are synced directly to every server the bot is currently
# in whenever it starts. No server ID is needed, and updates appear
# immediately rather than waiting for global-command propagation.
